{
    "root": true,
    "extends": ["@salesforce/eslint-config-lwc/recommended"],
    "env": {
        "node": true,
        "es2022": true
    },
    "overrides": [
        {
            "files": ["**/__tests__/**"],
            "env": {
                "jest": true
            }
        },
        {
            "files": ["jest-mocks/**/*.js"],
            "env": {
                "jest": true,
                "node": true
            },
            "rules": {
                "@lwc/lwc/no-unexpected-wire-adapter-usages": "off"
            }
        }
    ]
}
