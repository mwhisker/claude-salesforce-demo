<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Summary_Email</name>
        <label>Send Summary Email</label>
        <locationX>440</locationX>
        <locationY>650</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>RecipientEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>EmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>EmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_No_Complaints_Email</name>
        <label>Send No Complaints Email</label>
        <locationX>720</locationX>
        <locationY>350</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>RecipientEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue
                >There are no open complaint cases today.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>EmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <assignments>
        <name>Append_Case_To_Summary</name>
        <label>Append Case To Summary</label>
        <locationX>176</locationX>
        <locationY>530</locationY>
        <assignmentItems>
            <assignToReference>EmailBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CaseSummaryLine</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Complaint_Cases</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_For_Complaint_Cases</name>
        <label>Check For Complaint Cases</label>
        <locationX>440</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Send_No_Complaints_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Complaint Cases</defaultConnectorLabel>
        <rules>
            <name>Has_Complaint_Cases</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasComplaintCases</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Complaint_Cases</targetReference>
            </connector>
            <label>Has Complaint Cases</label>
        </rules>
    </decisions>
    <description
    >Runs daily at 8am UTC, summarizes all open Case records of type Complaint, and emails the summary to the support team.</description>
    <formulas>
        <name>HasComplaintCases</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Complaint_Cases}))</expression>
    </formulas>
    <formulas>
        <name>EmailSubject</name>
        <dataType>String</dataType>
        <expression
        >"Daily Complaints Case Summary - " &amp; TEXT(TODAY())</expression>
    </formulas>
    <formulas>
        <name>CaseSummaryLine</name>
        <dataType>String</dataType>
        <expression
        >Loop_Complaint_Cases.CaseNumber &amp; " - " &amp; Loop_Complaint_Cases.Subject &amp; " (" &amp; Loop_Complaint_Cases.Status &amp; ")" &amp; "\n"</expression>
    </formulas>
    <interviewLabel
    >Complaints Case Summary Daily Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Complaints Case Summary Daily Email</label>
    <loops>
        <name>Loop_Complaint_Cases</name>
        <label>Loop Through Complaint Cases</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <collectionReference>Get_Complaint_Cases</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Append_Case_To_Summary</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Send_Summary_Email</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Complaint_Cases</name>
        <label>Get Complaint Cases</label>
        <locationX>440</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound
        >false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_For_Complaint_Cases</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Complaint</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>314</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Complaint_Cases</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-01-01</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>RecipientEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>REPLACE_WITH_RECIPIENT_EMAIL@yourorg.com</stringValue>
        </value>
    </variables>
    <variables>
        <name>EmailBody</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Open Complaint Cases:\n\n</stringValue>
        </value>
    </variables>
</Flow>
