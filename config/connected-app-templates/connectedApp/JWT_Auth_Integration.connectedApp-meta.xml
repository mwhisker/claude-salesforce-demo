<?xml version="1.0" encoding="UTF-8"?>
<!--
  Connected App Metadata Template for JWT Authentication

  IMPORTANT: This is a REFERENCE TEMPLATE only. Due to Salesforce Metadata API limitations,
  this cannot be directly deployed with certificate data. Manual setup is required.

  Limitations:
  1. Cannot embed certificate data in metadata (must upload via UI)
  2. Consumer Key is auto-generated (cannot be preset)
  3. OAuth policies may require manual configuration

  Recommended Approach: Manual setup via Salesforce UI
  See: config/connected-app-templates/README.md

  To use this template as a starting point:
  1. Replace {{ALIAS}} with your org alias (e.g., UAT, PROD)
  2. Replace {{CONTACT_EMAIL}} with your email address
  3. Deploy via: sf project deploy start -d config/connected-app-templates/
  4. After deployment:
     - Upload certificate manually in Connected App settings
     - Configure OAuth policies
     - Create and assign Permission Set
-->
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>JWT Auth Integration {{ALIAS}}</label>
    <description>Connected App for JWT-based authentication. Generated by auth setup wizard.</description>
    <contactEmail>{{CONTACT_EMAIL}}</contactEmail>

    <oauthConfig>
        <!-- Standard OAuth callback URL for JWT flow -->
        <callbackUrl>https://login.salesforce.com/services/oauth2/success</callbackUrl>

        <!--
          Certificate CANNOT be embedded in metadata.
          Must be uploaded manually via UI after deployment.
          Path: Setup > App Manager > [App Name] > Edit > Upload Certificate
        -->

        <!-- OAuth scopes required for JWT authentication -->
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
        <scopes>OfflineAccess</scopes>

        <!-- Enable digital signatures for JWT -->
        <isAdminApproved>false</isAdminApproved>
        <isConsumerSecret>false</isConsumerSecret>
        <isIntrospectAllTokens>false</isIntrospectAllTokens>
        <isSecretRequiredForRefreshToken>false</isSecretRequiredForRefreshToken>
    </oauthConfig>

    <!--
      Note: The following OAuth policies cannot be reliably set via metadata in all Salesforce versions.
      Configure manually via: Setup > App Manager > [App Name] > Manage > Edit Policies

      Required settings:
      - Permitted Users: "Admin approved users are pre-authorized"
      - IP Relaxation: "Relax IP restrictions" (dev) or "Enforce IP restrictions" (prod)
      - Refresh Token Policy: "Refresh token is valid until revoked"
    -->
</ConnectedApp>
